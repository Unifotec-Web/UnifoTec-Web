# Public Node.js contact endpoint. Leave blank to use the email-draft fallback.
# Never set this to a private automation webhook or put credentials in a NEXT_PUBLIC variable.
NEXT_PUBLIC_CONTACT_API_URL=

# Future public Node.js hosted-checkout endpoint. Leave blank; online payment is not enabled.
# Never set this to a gateway secret endpoint or put credentials in a NEXT_PUBLIC variable.
NEXT_PUBLIC_PAYMENTS_API_URL=
